# Disable directory listing (prevents folder browsing)
Options -Indexes

# Prioritize PHP
DirectoryIndex index.php index.html

# Why: .env is gitignored but may exist on disk — block HTTP if the docroot includes the repo root.
<Files ".env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /it-management/
</IfModule>
