# Copy to project root as `.env` for production-style deployments.
# See also `.env.example` for the full variable catalog.
# Never commit a real production `.env` — restrict file permissions on the server.

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=itmanagement

# --- Production profile (explicit; default is production when both unset) ---
ITM_DEV=0
APP_ENV=production

# --- Required / recommended production keys ---
ITM_APP_URL=https://your-host.example.com/it-management/
# ITM_ALLOWED_HOSTS=your-host.example.com
# ITM_REQUEST_PASSWORD_APPROVAL_SECRET=
# ITM_SESSION_COOKIE_SECURE=1

# Verbose PHP errors: use Settings → UI Configuration per employee only when troubleshooting.
# Do not set ITM_DEV=1 on production hosts.
