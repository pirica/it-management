# Disable directory listing (prevents folder browsing)
Options -Indexes

# Why: Verbose PHP debug log lives here when enable_all_error_reporting is on — deny direct HTTP reads.
<FilesMatch "^error_log(-[0-9]+)?\.txt$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Prioritize PHP
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /it-management/
</IfModule>
