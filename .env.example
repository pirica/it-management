# Copy to `.env` in the project root (same folder as `config/`).
# Loaded on startup by `config/config.php` when present.
# Full reference: docs/ENV.md — drift audit: php scripts/check_env_vars_in_use.php

# --- Database (config/config.php via itm_mysqli_connect()) ---
# Keys read: DB_HOST, DB_PORT (default 3307 when empty), DB_USER, DB_PASS, DB_NAME.
# DB_CONNECTION is not used (Laravel-style keys are ignored).
# You may use host:port in DB_HOST instead of DB_PORT (e.g. 127.0.0.1:3307); explicit DB_PORT wins when the host has no port suffix.
#
# Dunebox MySQL 8.0 (local):
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_USER=root
# DB_PASS=secret
# DB_NAME=itmanagement

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_USER=
DB_PASS=
DB_NAME=

# --- Local CLI tooling (deploy-env.php, scripts, subprocess tests) ---
# PHPUnit requires CLI extensions: dom, json, libxml, mbstring, tokenizer, xml, xmlwriter.
# HTML coverage (--coverage) also needs Xdebug or PCOV on that same php.exe.
# Dunebox one-time setup (copies Xdebug from Laragon portable into D:\dunebox-v1.0.6):
#   powershell -ExecutionPolicy Bypass -File scripts/setup_dunebox_php_from_laragon.ps1
PHP_EXE=D:\dunebox-v1.0.6\system\apps\php\php-7.4.33-nts-Win32-vc15-x64\php.exe
# Or Dunebox shim (loads config/php/php-7.4.ini — run setup script to patch Xdebug there):
# PHP_EXE=D:\dunebox-v1.0.6\system\bin\php74.cmd
MYSQL_EXE=D:\dunebox-v1.0.6\system\apps\mysql\mysql-8.0.45-winx64\bin\mysql.exe

# --- Deployment / security (config/config.php) ---
# Canonical public base URL — avoids Host-header poisoning. Example: https://itm.example.com/app/
ITM_APP_URL=
# Comma-separated allowed Host values when ITM_APP_URL is empty (reverse-proxy / multi-host).
ITM_ALLOWED_HOSTS=
# Optional maintenance bypass token (see config/config.php).
ITM_MAINTENANCE_TOKEN=

# --- Application environment profile (config/config.php) ---
# APP_ENV labels the deployment: development | production (default production when unset).
# ITM_DEV=1 is a local-dev shortcut: when APP_ENV is empty, config treats the app as development.
# Values: 1, true, yes, on (case-insensitive). Does not auto-enable display_errors — that stays
# on Settings → UI Configuration → enable_all_error_reporting per employee (default off).
#
# Local Laragon / Dunebox (example — uncomment and adjust DB_* above):
# ITM_DEV=1
# APP_ENV=development
#
# Production (recommended — leave empty or set explicitly):
# ITM_DEV=0
# APP_ENV=production
ITM_DEV=
APP_ENV=

# Comma-separated client IPs/CIDRs for no-login browser scripts (count_db_tables.php, openapi.php).
# Built-in defaults always include 127.0.0.1; loopback (::1) is always allowed. Add monitor egress IPs here.
ITM_SCRIPT_NO_AUTH_ALLOWED_IPS=
# Comma-separated HTTP Host values for no-login browser scripts (merged with built-in localhost, 127.0.0.1, myhome.dynip.sapo.pt).
ITM_SCRIPT_NO_AUTH_ALLOWED_HOSTS=
# Force session/CSRF cookie Secure flag (1/0). When unset, Secure follows ITM_APP_URL https:// or per-request TLS.
ITM_SESSION_COOKIE_SECURE=
# Optional platform override for Explorer api.php per-employee hourly cap (Settings → API Access → Explorer API hourly limit when unset).
# ITM_EXPLORER_API_RATE_LIMIT_PER_HOUR=1200
# Set to 1 to skip must_change_password portal gate (local dev / bypass_login only — not for production).
# ITM_SKIP_FORCE_PASSWORD_CHANGE=0
# HMAC key for Request Password HR/HOD email approval links (modules/request_password/; includes/itm_request_password_approval.php).
ITM_REQUEST_PASSWORD_APPROVAL_SECRET=
# Set to 1 to disable System Status tenant cache fallback (admin module).
SYSTEM_STATUS_DISABLE_TENANT_FALLBACK=0

# --- IP2WHOIS — hosted domains by IP (IP Subnets → Search) ---
# Register: https://www.ip2whois.com/register
IP2WHOIS_API_KEY=
# Optional alias (same effect as IP2WHOIS_API_KEY):
# ITM_IP2WHOIS_API_KEY=
# --- MailerLite / onboarding approval HMAC (optional; onboarding falls back when empty) ---
MAILERLITE_API_KEY=
# Optional alias (same effect as MAILERLITE_API_KEY):
# ITM_MAILERLITE_API_KEY=

# --- NVD CVE API (News module → CVE (NVD) source; optional — higher rate limits) ---
# Request a key: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Optional alias (same effect as NVD_API_KEY):
# ITM_NVD_API_KEY=

# --- Resend — fallback when no tenant SMTP profile (includes/itm_email.php) ---
# https://resend.com/
RESEND_API_KEY=
