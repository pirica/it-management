# Full reference: docs/ENV.md — drift audit: php scripts/check_env_vars_in_use.php

# Copy to `.env` in the project root.
# `.env` is read on startup by `config/config.php` when present.

# IP2WHOIS — hosted domains by IP (Network Discovery on IP Subnets → Search).
# Get a key: https://www.ip2whois.com/register
# API: GET https://domains.ip2whois.com/domains?ip={ip}&key={key}


# --- Database (config/config.php → itm_mysqli_connect()) ---
## DB_HOST: MySQL hostname; may include :port (e.g. 127.0.0.1:3306). DB_PORT wins if host has no port suffix.
## DB_PORT: MySQL listener. Laragon default 3306; Dunebox uses 3307. Must match MYSQL_PORT for import scripts.
## DB_USER / DB_PASS / DB_NAME: Application database credentials.

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=itmanagement
DB_USER=
DB_PASS=

## ITM_REQUEST_PASSWORD_APPROVAL_SECRET: HMAC key for Request Password HR/HOD email approval links.
## Used in: includes/itm_request_password_approval.php, modules/request_password/
ITM_REQUEST_PASSWORD_APPROVAL_SECRET=

# --- System Status admin module (config/config.php) ---
## SYSTEM_STATUS_DISABLE_TENANT_FALLBACK: 1 disables tenant cache fallback when session company_id missing.
## Used by: modules/system_status/ admin cache (ITM_SYSTEM_STATUS_CACHE_GLOBAL_COMPANY_ID fallback).
## Laragon: 0 (default) keeps fallback behaviour.
SYSTEM_STATUS_DISABLE_TENANT_FALLBACK=0


# --- Deployment / URL hardening (config/config.php) ---
## ITM_APP_URL: Canonical public base URL for BASE_URL / generated links. Stops Host-header poisoning.
## Used in: config/config.php (BASE_URL), includes/itm_security_headers.php (session cookie Secure when https://).
## Laragon local: set to your docroot alias. Empty works on localhost but audit flags "missing in .env".
ITM_APP_URL=http://localhost/it-management/
#ITM_APP_URL=http://myhome.dynip.sapo.pt/it-management/

## ITM_ALLOWED_HOSTS: Comma-separated allowed HTTP Host values when ITM_APP_URL is empty.
## Used in: config/config.php — if request Host not in list, first allowlisted host is substituted.
## Local Laragon: leave empty when ITM_APP_URL is set.
ITM_ALLOWED_HOSTS=


## ITM_MAINTENANCE_TOKEN: Optional shared secret for no-login browser scripts.
## Used in: scripts/lib/itm_script_bootstrap.php → itm_script_browser_no_auth_client_allowed()
## via ?token= or header X-ITM-Maintenance-Token (with count_db_tables.php, openapi.php, test_chatbot.php).
## Leave empty for local loopback-only access.
ITM_MAINTENANCE_TOKEN=

# --- Application environment profile (config/config.php → APP_ENV constant) ---
## ITM_DEV: Local dev shortcut. When APP_ENV is empty, 1/true/yes/on implies development.
## Does NOT enable display_errors — that is per-employee Settings → UI Configuration.
ITM_DEV=1
## APP_ENV: deployment label: development | production (invalid → production).
APP_ENV=development

# --- No-auth browser scripts (scripts/lib/itm_script_bootstrap.php) ---
## Built-in hosts always allowed: localhost, 127.0.0.1, myhome.dynip.sapo.pt; loopback IPs always allowed.
## Scripts: count_db_tables.php, openapi.php, test_chatbot.php (define ITM_SCRIPT_NO_AUTH).
## ITM_SCRIPT_NO_AUTH_ALLOWED_IPS: Extra client IPs/CIDRs (monitors, office egress). Laragon: usually empty.
ITM_SCRIPT_NO_AUTH_ALLOWED_IPS=
## ITM_SCRIPT_NO_AUTH_ALLOWED_HOSTS: Extra HTTP Host values merged with built-in list.
ITM_SCRIPT_NO_AUTH_ALLOWED_HOSTS=

# --- Session cookies (includes/itm_security_headers.php → itm_session_cookie_secure()) ---
## ITM_SESSION_COOKIE_SECURE: Force PHPSESSID / CSRF cookie Secure flag: 1 or 0.
## When empty: Secure=true if ITM_APP_URL is https:// or request is TLS-detected.
## Laragon http://localhost: leave empty or 0.
ITM_SESSION_COOKIE_SECURE=

# --- Explorer module API rate limit (includes/itm_explorer_api_rate_limit.php) ---
## ITM_EXPLORER_API_RATE_LIMIT_PER_HOUR: Platform override for Explorer modules/explorer/api.php hourly cap.
## When unset: per-employee ui_configuration.explorer_api_rate_limit_per_hour (Settings → API Access, default 1200; 0=unlimited).
## Laragon: leave unset unless you want a global cap overriding Settings.
ITM_EXPLORER_API_RATE_LIMIT_PER_HOUR=1200

# --- Local dev conveniences ---
## ITM_SKIP_FORCE_PASSWORD_CHANGE: 1 skips must_change_password gate (force-password-change.php). Local only.
ITM_SKIP_FORCE_PASSWORD_CHANGE=1



# --- Local CLI tooling (deploy-env.php, scripts, subprocess tests) ---
# PHPUnit requires CLI extensions: dom, json, libxml, mbstring, tokenizer, xml, xmlwriter.
# HTML coverage (--coverage) also needs Xdebug or PCOV on that same php.exe.
# Dunebox one-time setup (copies Xdebug from Laragon portable into D:\dunebox-v1.0.6):
#   powershell -ExecutionPolicy Bypass -File scripts/setup_dunebox_php_from_laragon.ps1
PHP_EXE=D:\dunebox-v1.0.6\system\apps\php\php-7.4.33-nts-Win32-vc15-x64\php.exe
# Or Dunebox shim (loads config/php/php-7.4.ini — run setup script to patch Xdebug there):
# PHP_EXE=D:\dunebox-v1.0.6\system\bin\php74.cmd
MYSQL_EXE=D:\dunebox-v1.0.6\system\apps\mysql\mysql-8.0.45-winx64\bin\mysql.exe
# MYSQL_BIN: optional CLI override for scripts/import_database_split.php (defaults to mysql on PATH).
# MYSQL_BIN=/usr/bin/mysql



# --- IP2WHOIS — IP Subnets → Search hosted domains (optional) ---
## IP2WHOIS_API_KEY: https://www.ip2whois.com/register
IP2WHOIS_API_KEY=

# Optional alias (same effect as IP2WHOIS_API_KEY):
ITM_IP2WHOIS_API_KEY=

# --- NVD CVE API — News module CVE source (optional, higher rate limits) ---
## NVD_API_KEY: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Optional alias (same effect as NVD_API_KEY):
ITM_NVD_API_KEY=

# --- MailerLite / onboarding approval HMAC (config/config.php → MAILERLITE_API_KEY constant) ---
## MAILERLITE_API_KEY: Secret for HMAC on employee onboarding approval email links.
## Used in: modules/employee_onboarding_requests/ when non-empty; empty uses internal fallback.
MAILERLITE_API_KEY=
## ITM_MAILERLITE_API_KEY: Optional alias — same effect as MAILERLITE_API_KEY if primary is empty.
ITM_MAILERLITE_API_KEY=

# --- Resend — email fallback when no tenant SMTP (includes/itm_email.php) ---
## RESEND_API_KEY: https://resend.com/
RESEND_API_KEY=

# --- Local Mailpit — inbound email → tickets (includes/itm_inbound_email_tickets.php) ---
## When imap_host on the default SMTP profile is "mailpit", polling uses the Mailpit HTTP API (no PHP imap).
## Laragon: http://localhost/mailpit/ — see docs/EMAIL_MANAGEMENT.md
# ITM_MAILPIT_API_URL=http://localhost/mailpit/api/v1
# ITM_MAILPIT_SMTP_HOST=127.0.0.1
# ITM_MAILPIT_SMTP_PORT=1025

# --- Network discovery SNMP (includes/itm_network_discovery.php) ---
## ITM_NETWORK_DISCOVERY_SNMP_COMMUNITY: default SNMP community when scanning subnets (optional).
# ITM_NETWORK_DISCOVERY_SNMP_COMMUNITY=public

# --- Legacy ticket CSAT public links (includes/itm_ticket_csat.php) ---
## ITM_TICKET_CSAT_SECRET: HMAC secret for legacy ticket-csat.php tokens. Prefer ticket_surveys module.
# ITM_TICKET_CSAT_SECRET=

# --- Hotel distribution — Booking.com connect sandbox (includes/itm_hotel_booking_distribution_booking_com_connect.php) ---
## ITM_BOOKING_COM_SANDBOX_URL: override sandbox base URL for partner connect testing only.
# ITM_BOOKING_COM_SANDBOX_URL=
