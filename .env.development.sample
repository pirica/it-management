# Template: .env.development.sample — copy to project root as `.env` for local Laragon / Dunebox development.
# Canonical reference: docs/ENV.md — see also `.env.example`.

# --- Database (Dunebox MySQL 8.0 on port 3307) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASS=secret
DB_NAME=itmanagement

# --- Local dev profile ---
ITM_DEV=1
APP_ENV=development

# --- Optional local conveniences ---
# ITM_SKIP_FORCE_PASSWORD_CHANGE=1
# ITM_APP_URL=http://localhost/it-management/

# --- CLI tooling (Windows Dunebox — adjust paths) ---
# PHP_EXE=D:\dunebox-v1.0.6\system\apps\php\php-7.4.33-nts-Win32-vc15-x64\php.exe
# MYSQL_EXE=D:\dunebox-v1.0.6\system\apps\mysql\mysql-8.0.45-winx64\bin\mysql.exe
